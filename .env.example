# ─────────────────────────────────────────────────────────────
# Seraya Retail Intelligence Co-Pilot — Environment Variables
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────

# Required — OpenAI API key (server-side only, never exposed to browser)
OPENAI_API_KEY=

# Optional — Override the default model (default: gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini

# Optional — Public app name (visible in browser tab / header)
NEXT_PUBLIC_APP_NAME=Seraya Retail Intelligence Co-Pilot

# Optional — Environment label (development | staging | production)
APP_ENV=development

# ─────────────────────────────────────────────────────────────
# Future: Railway backend split (not required for Vercel-only deploy)
# ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_BASE_URL=https://your-vercel-app.vercel.app
# RAILWAY_API_BASE_URL=https://your-railway-service.up.railway.app
