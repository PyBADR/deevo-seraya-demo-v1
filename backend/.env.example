# ─────────────────────────────────────────────────────────────
# Seraya Co-Pilot Backend — Environment Variables
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# LLM Provider: openai | lmstudio | ollama | deterministic
LLM_PROVIDER=deterministic

# OpenAI (cloud mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# LM Studio (local/private mode)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# Ollama (local/private mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Database (defaults match docker-compose.yml)
POSTGRES_URL=postgresql://seraya:seraya_local@localhost:5432/seraya
MONGO_URL=mongodb://seraya:seraya_local@localhost:27017
REDIS_URL=redis://localhost:6379

# API key for Custom GPT / external access
DEEVO_API_KEY=

# Environment
APP_ENV=development
