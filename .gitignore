# ─────────────────────────────────────────────────────────────
# Seraya Retail Intelligence Co-Pilot — .gitignore
# ─────────────────────────────────────────────────────────────

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/

# Production builds
/build
/dist

# Environment variables (NEVER commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keep .env.example for onboarding
!.env.example

# Vercel
.vercel

# TypeScript build artifacts
*.tsbuildinfo
next-env.d.ts

# OS files
.DS_Store
Thumbs.db
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / IDE
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Test artifacts
/tests/output/
